[Unit]
Description=Sincronizarea completă a magazinelor Shopify (produse, stoc, comenzi deschise)
After=octogon.service

[Service]
Type=oneshot
User=octogon
EnvironmentFile=/opt/octogon/.env
ExecStart=/bin/sh -c 'curl -fsS -X POST -H "X-Octogon-Sync: $SYNC_SECRET" http://127.0.0.1:3000/shopify/sync'
