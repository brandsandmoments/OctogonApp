# Copia de test a OctogonApp: aceeași aplicație, altă bază (octogon_test), port 3001.
# Caddy o servește la test.<domeniu>. Clienții din magazine sunt anonimizați (OCTOGON_TEST=1).
[Unit]
Description=OctogonApp (copia de test)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=octogon
WorkingDirectory=/opt/octogon-test
EnvironmentFile=/opt/octogon-test/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm start -- -H 127.0.0.1 -p 3001
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
