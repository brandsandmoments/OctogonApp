[Unit]
Description=Financiar: coletele Fan și GLS, facturile din xConnector, rambursurile virate
After=octogon.service

[Service]
Type=oneshot
User=octogon
EnvironmentFile=/opt/octogon/.env
ExecStart=/bin/sh -c 'curl -fsS -m 1800 -X POST -H "X-Octogon-Sync: $SYNC_SECRET" "http://127.0.0.1:3000/financiar/sync"'
