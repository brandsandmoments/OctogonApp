# Rolul aplicatiei, nu proprietarul tabelelor: asa nu poate ocoli politicile de izolare.
DATABASE_URL=postgres://octogon_app@localhost:5432/octogon

# Firma pentru scripturi (import, sincronizare Shopify, primul admin), care
# ruleaza fara om logat. Aplicatia ia firma din sesiunea omului logat.
FIRMA_ID=0c706000-0000-4000-8000-000000000001

# Aplicatia Octogon din Shopify Dev Dashboard (vezi docs/shopify.md): se instaleaza
# pe fiecare magazin din „Legaturi Shopify". APP_URL e adresa publica a aplicatiei.
# SHOPIFY_CHEIE cripteaza tokenurile magazinelor in baza: openssl rand -hex 32.
# SYNC_SECRET pazeste sincronizarea de noapte: openssl rand -hex 24.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_CHEIE=
APP_URL=https://app.octogonfashion.com
SYNC_SECRET=

# Rezumatul de dimineata pe Slack: Incoming Webhook al canalului (api.slack.com/apps → Incoming Webhooks).
SLACK_WEBHOOK_URL=

# Varianta veche, fara instalare: tokenul unei aplicatii custom, pe magazin.
# Magazinele Shopify, cate unul pe brand (codurile din tabela magazin).
# Pentru fiecare: o aplicatie custom in Shopify admin cu acces read_orders;
# domeniul e cel .myshopify.com, tokenul incepe cu shpat_. Nu le pune in git.
SHOPIFY_SHOP_PARSEEA=
SHOPIFY_TOKEN_PARSEEA=
SHOPIFY_SHOP_MAISON_LOULOU=
SHOPIFY_TOKEN_MAISON_LOULOU=
SHOPIFY_SHOP_SLEEVY=
SHOPIFY_TOKEN_SLEEVY=
